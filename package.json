{
  "name": "tetris-knockout",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @tk/web dev",
    "dev:https": "pnpm --filter @tk/web dev:https",
    "build": "pnpm --filter @tk/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine && tsc -p packages/net && tsc -p packages/coordinator && tsc -p apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
